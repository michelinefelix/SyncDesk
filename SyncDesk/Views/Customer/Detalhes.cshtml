@model SyncDesk.Models.Entities.Customer

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Perfil do Cliente - @Model.Nome</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body class="bg-light d-flex align-items-center min-vh-100">
    <div class="container py-4">
        <div class="card shadow border-0 col-md-6 mx-auto rounded-3">
            <div class="card-header bg-dark text-white p-3 d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold"><i class="bi bi-person-vcard text-primary me-2"></i>Perfil do Cliente</h5>
                <span class="badge bg-secondary font-monospace">@Model.Id</span>
            </div>
            <div class="card-body p-4">
                <div class="mb-3 border-bottom pb-2">
                    <label class="form-label text-muted small fw-bold text-uppercase mb-1">Nome Completo</label>
                    <p class="fs-5 fw-semibold mb-0 text-dark">@Model.Nome</p>
                </div>
                <div class="mb-3 border-bottom pb-2">
                    <label class="form-label text-muted small fw-bold text-uppercase mb-1">E-mail</label>
                    <p class="fs-5 mb-0"><a href="mailto:@Model.Email" class="text-decoration-none">@Model.Email</a></p>
                </div>
                <div class="mb-2">
                    <label class="form-label text-muted small fw-bold text-uppercase mb-1">WhatsApp / Telefone</label>
                    <p class="fs-5 mb-0 text-dark">@(string.IsNullOrWhiteSpace(Model.TelefoneWhatsApp) ? "Não informado" : Model.TelefoneWhatsApp)</p>
                </div>
            </div>
            <div class="card-footer bg-white p-3 border-top text-end">
                <button onclick="window.close()" class="btn btn-outline-secondary px-4 fw-semibold">
                    <i class="bi bi-x-lg me-1"></i> Fechar Aba
                </button>
            </div>
        </div>
    </div>
</body>
</html>