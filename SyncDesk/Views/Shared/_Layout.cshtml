<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SyncDesk</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
            body { background-color: #f8f9fa; font-family: 'Segoe UI', system-ui, sans-serif; }
            .navbar-brand { font-weight: 700; letter-spacing: 0.5px; }
            .card-custom { border: none; border-radius: 12px; box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075); }
            .badge-status { font-size: 0.75rem; padding: 0.4em 0.75em; border-radius: 50rem; }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
        <div class="container">
            <a class="navbar-brand text-primary fw-bold" asp-controller="Ticket" asp-action="Index">
                <i class="bi bi-headset me-2"></i>SyncDesk
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link text-light" asp-controller="Ticket" asp-action="Index">
                            <i class="bi bi-ticket-perforated me-1"></i>Chamados
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-light" asp-controller="Ticket" asp-action="Fila">
                            <i class="bi bi-list-task me-1"></i>Fila de Espera
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-light" asp-controller="Admin" asp-action="Departamentos">
                            <i class="bi bi-building me-1"></i>Departamentos
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-light" asp-controller="Admin" asp-action="Dashboard">
                            <i class="bi bi-speedometer2 me-1"></i>Dashboard
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="container py-4">
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>