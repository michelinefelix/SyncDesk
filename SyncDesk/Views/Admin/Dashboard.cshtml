@model SyncDesk.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard Administrativo";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-speedometer2 me-2 text-primary"></i>Dashboard - @Model.Tenant?.RazaoSocial</h2>
        <p class="text-muted mb-0">Visão geral e métricas da sua operação de atendimento</p>
    </div>
</div>

<!-- Cards de Métricas Operacionais -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card card-custom bg-primary text-white p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-white-50 text-uppercase fw-bold mb-1" style="font-size: 0.8rem;">Total Chamados</h6>
                    <h2 class="fw-bold mb-0">@Model.TotalTickets</h2>
                </div>
                <i class="bi bi-headset fs-1 opacity-50"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-custom bg-warning text-dark p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-dark-50 text-uppercase fw-bold mb-1" style="font-size: 0.8rem;">Aguardando Fila</h6>
                    <h2 class="fw-bold mb-0">@Model.TicketsAguardando</h2>
                </div>
                <i class="bi bi-clock-history fs-1 opacity-50"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-custom bg-info text-white p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-white-50 text-uppercase fw-bold mb-1" style="font-size: 0.8rem;">Em Atendimento</h6>
                    <h2 class="fw-bold mb-0">@Model.TicketsEmAtendimento</h2>
                </div>
                <i class="bi bi-chat-dots fs-1 opacity-50"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-custom bg-dark text-white p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-white-50 text-uppercase fw-bold mb-1" style="font-size: 0.8rem;">Departamentos</h6>
                    <h2 class="fw-bold mb-0">@Model.TotalDepartamentos</h2>
                </div>
                <i class="bi bi-building fs-1 opacity-50"></i>
            </div>
        </div>
    </div>
</div>

<!-- Dados do Tenant/Organização -->
<div class="card card-custom p-4">
    <h5 class="fw-bold mb-3"><i class="bi bi-shield-check me-2 text-success"></i>Dados da Conta</h5>
    <div class="row">
        <div class="col-md-6 border-end">
            <p class="mb-1 text-muted">CNPJ Cadastrado</p>
            <h6 class="fw-bold">@Model.Tenant?.CNPJ</h6>
        </div>
        <div class="col-md-6 ps-4">
            <p class="mb-1 text-muted">Plano de Assinatura</p>
            <span class="badge bg-success fs-6">@Model.Tenant?.Plano</span>
        </div>
    </div>
</div>