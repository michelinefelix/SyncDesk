@using SyncDesk.Models.Enums
@model IEnumerable<SyncDesk.Models.Entities.Ticket>

@{
    ViewData["Title"] = "Fila de Espera";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-list-task me-2 text-warning"></i>Fila de Espera</h2>
        <p class="text-muted mb-0">Chamados aguardando atendimento de um agente</p>
    </div>
</div>

<div class="card card-custom p-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Protocolo</th>
                    <th>Cliente</th>
                    <th>Assunto</th>
                    <th>Departamento</th>
                    <th>Prioridade</th>
                    <th>Data Abertura</th>
                    <th class="text-end">Ações</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">
                            <i class="bi bi-check-circle fs-3 d-block mb-2 text-success"></i>
                            Nenhum chamado aguardando na fila no momento!
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var ticket in Model)
                    {
                        <tr>
                            <td><code>@ticket.Protocolo</code></td>
                            <td class="fw-semibold">@(ticket.Customer?.Nome ?? "Cliente N/A")</td>
                            <td>@ticket.Assunto</td>
                            <td><span class="badge bg-secondary">@(ticket.Department?.Nome ?? "Geral")</span></td>
                            <td><span class="badge bg-warning text-dark">@ticket.Prioridade</span></td>
                            <td class="text-muted small">@ticket.DataAbertura.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-end">
                                <a asp-action="Atender" asp-route-id="@ticket.Id" class="btn btn-sm btn-success">
                                    <i class="bi bi-play-fill me-1"></i> Atender
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>