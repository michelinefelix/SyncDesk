@model SyncDesk.Models.Entities.Ticket
@{
    ViewData["Title"] = $"Atendimento - {Model.Protocolo}";
    var mensagens = ViewBag.Mensagens as IEnumerable<SyncDesk.Models.Entities.Message> ?? new List<SyncDesk.Models.Entities.Message>();
}

<div class="row">
    <!-- Informações do Ticket -->
    <div class="col-md-4 mb-3">
        <div class="card card-custom p-3">
            <h5 class="fw-bold mb-3"><i class="bi bi-info-circle me-2 text-primary"></i>Detalhes do Ticket</h5>
            <ul class="list-group list-group-flush mb-3">
                <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                    <span class="text-muted">Protocolo:</span>
                    <code>@Model.Protocolo</code>
                </li>
                <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                   <span class="text-muted">Cliente:</span>
                    <a asp-controller="Customer" 
                        asp-action="Detalhes" 
                        asp-route-id="@Model.CustomerId" 
                        target="_blank" 
                        class="fw-bold text-primary text-decoration-none ms-1">
                        @Model.Customer?.Nome <i class="bi bi-box-arrow-up-right small"></i>
                    </a>
                </li>
                <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                    <span class="text-muted">Departamento:</span>
                    <span>@(Model.Department?.Nome ?? "Geral")</span>
                </li>
                <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                    <span class="text-muted">Status:</span>
                    <span class="badge bg-primary">@Model.Status</span>
                </li>
                <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                    <span class="text-muted">Prioridade:</span>
                    <span class="badge bg-warning text-dark">@Model.Prioridade</span>
                </li>
            </ul>

            <!-- Ações do Agente -->
            @if (Model.AgentId == null && Model.Status != SyncDesk.Models.Enums.TicketStatusEnum.Encerrado)
            {
                <form asp-controller="Ticket" asp-action="AtribuirAgente" method="post" class="mb-2">
                    <input type="hidden" name="ticketId" value="@Model.Id" />
                    <input type="hidden" name="agentId" value="22222222-2222-2222-2222-222222222222" />
                    <button type="submit" class="btn btn-success w-100">
                        <i class="bi bi-person-check me-1"></i> Assumir Atendimento
                    </button>
                </form>
            }
            else if (Model.AgentId != null)
            {
                <div class="alert alert-light border text-center mb-3">
                    <i class="bi bi-person-badge me-1"></i>
                    <strong>Agente:</strong> @(Model.Agent?.Nome ?? "Atribuído")
                </div>
            }

            @if (Model.Status != SyncDesk.Models.Enums.TicketStatusEnum.Encerrado)
            {
                <form asp-action="Encerrar" method="post">
                    <input type="hidden" name="ticketId" value="@Model.Id" />
                    <button type="submit" class="btn btn-outline-danger w-100">
                        <i class="bi bi-x-circle me-1"></i> Encerrar Chamado
                    </button>
                </form>
            }
        </div>
    </div>

    <!-- Interface do Chat -->
    <div class="col-md-8">
        <div class="card card-custom d-flex flex-column" style="height: 600px;">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="fw-bold mb-0">@Model.Assunto</h5>
            </div>
            <!-- Corpo de Mensagens -->
            <div id="chatBox" class="card-body overflow-auto flex-grow-1 bg-light p-3">
                @foreach (var msg in mensagens)
                {
                    var isAgente = msg.TipoRemetente == SyncDesk.Models.Enums.TipoRemetenteEnum.Agente;
                    <div class="d-flex mb-3 @(isAgente ? "justify-content-end" : "justify-content-start")">
                        <div class="p-3 rounded-3 shadow-sm @(isAgente ? "bg-primary text-white" : "bg-white")" style="max-width: 75%;">
                            <p class="mb-1 text-break">@msg.Conteudo</p>
                            <small class="@(isAgente ? "text-white-50" : "text-muted") float-end ms-2" style="font-size: 0.7rem;">
                                @msg.DataEnvio.ToString("HH:mm")
                            </small>
                        </div>
                    </div>
                }
            </div>

            @if (Model.AgentId != null && Model.Status != SyncDesk.Models.Enums.TicketStatusEnum.Encerrado){ 
            <!-- Entrada de Mensagem -->
            <div class="card-footer bg-white p-3 border-top">
                @if (Model.Status == SyncDesk.Models.Enums.TicketStatusEnum.Encerrado)
                {
                    <div class="alert alert-secondary mb-0 text-center py-2" role="alert">
                        <i class="bi bi-lock-fill me-1"></i> Este chamado está encerrado e não aceita novas mensagens.
                    </div>
                }
                else
                {
                    <form id="chatForm" class="d-flex gap-2">
                        <input type="text" id="mensagemInput" class="form-control" placeholder="Digite sua mensagem..." required autocomplete="off" />
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-send-fill"></i>
                        </button>
                    </form>
                }
            </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script>
        const ticketId = "@Model.Id";
        const agentId = "@(Model.AgentId?.ToString() ?? "22222222-2222-2222-2222-222222222222")";
        const chatBox = document.getElementById("chatBox");
        const chatForm = document.getElementById("chatForm");

        if (chatBox) chatBox.scrollTop = chatBox.scrollHeight;

        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/atendimentoHub")
            .withAutomaticReconnect()
            .build();

        connection.start().then(() => {
            connection.invoke("EntrarNaSalaTicket", ticketId);
        }).catch(err => console.error("Erro no SignalR:", err.toString()));

        connection.on("ReceberMensagem", (remetenteId, conteudo, hora) => {
            const msgElement = document.createElement("div");
            msgElement.className = "d-flex mb-3 justify-content-start";
            msgElement.innerHTML = `
                        <div class="p-3 rounded-3 shadow-sm bg-white" style="max-width: 75%;">
                            <p class="mb-1 text-break">${conteudo}</p>
                            <small class="text-muted float-end ms-2" style="font-size: 0.7rem;">${hora}</small>
                        </div>
                    `;
            chatBox.appendChild(msgElement);
            chatBox.scrollTop = chatBox.scrollHeight;
        });

        if (chatForm) {
            chatForm.addEventListener("submit", function(e) {
                e.preventDefault();
                const input = document.getElementById("mensagemInput");
                const conteudo = input.value.trim();
                if (!conteudo) return;

                // TipoRemetente 2 = Agente
                connection.invoke("EnviarMensagemAoVivo", ticketId, agentId, 2, conteudo)
                    .then(() => {
                        const msgElement = document.createElement("div");
                        msgElement.className = "d-flex mb-3 justify-content-end";
                        msgElement.innerHTML = `
                                    <div class="p-3 rounded-3 shadow-sm bg-primary text-white" style="max-width: 75%;">
                                        <p class="mb-1 text-break">${conteudo}</p>
                                        <small class="text-white-50 float-end ms-2" style="font-size: 0.7rem;">${new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}</small>
                                    </div>
                                `;
                        chatBox.appendChild(msgElement);
                        chatBox.scrollTop = chatBox.scrollHeight;
                        input.value = "";
                    })
                    .catch(err => console.error("Erro ao enviar mensagem:", err.toString()));
            });
        }
    </script>
}
